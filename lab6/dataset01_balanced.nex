BEGIN MRBAYES;

	set autoclose=yes nowarn=yes;

	lset nst=6 rates=gamma ngammacat=4;

	prset statefreqpr=dirichlet(1,1,1,1)
	      revmatpr=dirichlet(1,1,1,1,1,1)
	      shapepr=exponential(1.0)
	      topologypr=uniform
	      brlenspr=unconstrained:exponential(10.0);

	mcmcp ngen=100000
	      nruns=2
	      nchains=4
	      temp=0.1
	      samplefreq=1000
	      printfreq=1000
	      diagnfreq=5000
	      savebrlens=yes
	      filename=dataset01_balanced;
	mcmc;

	sumt burninfrac=0.25 contype=allcompat;
	sump burninfrac=0.25;

END;
